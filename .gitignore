# Dependencies
node_modules/

# Environment files — only .env.example is committed
.env
.env.*
!.env.example

# Build output
dist/
build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.idea/
*.swp

# Uploaded project runtime data — keep folder structure only (.gitkeep)
storage/uploads/*
storage/extracted/*
storage/working/*
storage/exports/*
storage/temp/*
!storage/uploads/.gitkeep
!storage/extracted/.gitkeep
!storage/working/.gitkeep
!storage/exports/.gitkeep
!storage/temp/.gitkeep
