# TechBridge AI — Backend environment configuration
# Copy this file to .env and fill in real values.
# The .env file must never be committed to Git, and secrets must never reach the frontend.

# Server
PORT=5000

# CORS — comma-separated allowed origins, or * for any origin (restrict this for production)
CORS_ORIGIN=*

# Project upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_ENTRIES=10000
MAX_ZIP_UNCOMPRESSED_MB=500

# Maximum file size (MB) served by the file content API
MAX_FILE_CONTENT_MB=2

# Storage root override (absolute path). Default: <repo>/storage
# STORAGE_ROOT=

# MySQL — database "techbridge_ai" (schema is managed manually via database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=techbridge_ai

# Authentication
JWT_SECRET=
# Token lifetime accepted by jsonwebtoken (e.g. 1h, 12h, 7d)
JWT_EXPIRES_IN=24h

# AI providers — fallback order: Groq -> Gemini -> OpenAI
# Keys live ONLY in this file (the real .env), never in code, MySQL, or the frontend.
AI_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=
# Per-request timeout applied to every AI provider call (milliseconds)
AI_TIMEOUT_MS=60000
# Focused AI context limits (docs/PROJECT_SPEC.md section 4.2)
# Total rendered context characters per AI request
AI_CONTEXT_MAX_CHARS=24000
# Source-code excerpt characters included per selected file
AI_CONTEXT_FILE_EXCERPT_CHARS=4000
# AI chat limits (docs/API_CONTRACT.md sections 14-15)
# Maximum user message length (characters)
AI_CHAT_MAX_MESSAGE_CHARS=8000
# Prior conversation turns replayed to the AI provider
AI_CHAT_HISTORY_MESSAGES=20
# Response token cap for chat requests
AI_CHAT_MAX_TOKENS=2048
# Chat generation temperature (0 factual - 2 creative)
AI_CHAT_TEMPERATURE=0.2
